    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretest": "npm run generate",
    "test": "tsx test/faz2_tests.ts && tsx test/faz3_semantic_test.ts && tsx test/faz4_report_test.ts && tsx test/faz5_export_test.ts && tsx test/clean_install_test.ts && tsx test/faz6_release_readiness_test.ts",
    "test:windows": "tsx test/faz2_tests.ts && tsx test/faz3_semantic_test.ts && tsx test/faz4_report_test.ts && tsx test/faz5_export_test.ts && tsx test/faz6_release_readiness_test.ts",
    "release:check": "npm run test && npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "git:prepare": "node scripts/git_prepare.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-sql": "^2.2.0",
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.17.19",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.11"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
